    <run id="mcmc" spec="MCMC" chainLength="2000000">
        <state id="state" spec="State" storeEvery="5000">
            <tree id="Tree.t:ca.codon" spec="beast.base.evolution.tree.Tree" name="stateNode">
                <taxonset id="TaxonSet.ca.codon" spec="TaxonSet">
                    <alignment id="ca.codon" spec="codonmodels.evolution.alignment.CodonAlignmentFromAminoAcids" geneticCode="vertebrateMitochondrial" dataType="codon">
                        <data idref="codon"/>
                    </alignment>
                </taxonset>
            </tree>
            <stateNode id="M0.omega.s:ca.codon" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="NonNegativeReal">1.0</stateNode>
            <stateNode id="M0.kappa.s:ca.codon" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">2.0</stateNode>
            <stateNode id="gammaShape.s:ca.codon" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">1.0</stateNode>
            <stateNode id="popSize.t:ca.codon" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">0.3</stateNode>
        </state>
        
        <init id="RandomTree.t:ca.codon" spec="beast.base.spec.evolution.tree.coalescent.RandomTree" estimate="false" initial="@Tree.t:ca.codon" taxa="@ca.codon">
            <populationModel id="ConstantPopulation0.t:ca.codon" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
                <popSize id="randomPopSize.t:ca.codon" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</popSize>
            </populationModel>
        </init>
        
        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="CoalescentConstant.t:ca.codon" spec="Coalescent">
                    <populationModel id="ConstantPopulation.t:ca.codon" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation" popSize="@popSize.t:ca.codon"/>
                    <treeIntervals id="TreeIntervals.t:ca.codon" spec="beast.base.evolution.tree.TreeIntervals" tree="@Tree.t:ca.codon"/>
                </distribution>
                <distribution id="LogNormalDistributionModel.1" spec="beast.base.spec.inference.distribution.LogNormal" param="@M0.kappa.s:ca.codon">
                        <M id="RealParameter.2" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">2.0</M>
                        <S id="RealParameter.3" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.25</S>
                    </distribution>
                <distribution id="LogNormalDistributionModel.0" spec="beast.base.spec.inference.distribution.LogNormal" param="@M0.omega.s:ca.codon">
                        <M id="RealParameter.0" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">-3.0</M>
                        <S id="RealParameter.1" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.25</S>
                    </distribution>
                <distribution id="Exponential.0" spec="beast.base.spec.inference.distribution.Exponential" param="@gammaShape.s:ca.codon">
                        <mean id="RealParameter.4" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</mean>
                    </distribution>
                <distribution id="PopSizePrior.t:ca.codon" spec="beast.base.spec.inference.distribution.Gamma" param="@popSize.t:ca.codon"><alpha spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="0.01" estimate="false"/><theta spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="100.0" estimate="false"/></distribution>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                <distribution id="treeLikelihood.ca.codon" spec="beast.base.spec.evolution.likelihood.ThreadedTreeLikelihood" data="@ca.codon" tree="@Tree.t:ca.codon" useAmbiguities="true">
                    <siteModel id="SiteModel.s:ca.codon" spec="beast.base.spec.evolution.sitemodel.SiteModel" gammaCategoryCount="4" shape="@gammaShape.s:ca.codon">
                        <mutationRate id="mutationRate.s:ca.codon" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">1.0</mutationRate>
                        <proportionInvariant id="proportionInvariant.s:ca.codon" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval">0.0</proportionInvariant>
                        <substModel id="M0.s:ca.codon" spec="codonmodels.M0Model" kappa="@M0.kappa.s:ca.codon" omega="@M0.omega.s:ca.codon">
                            <frequencies id="codonFreqs.s:ca.codon" spec="beast.base.spec.evolution.substitutionmodel.Frequencies" estimate="false"> 
                            	<frequencies dimension="60" value="0.0166666666666667" spec="beast.base.spec.inference.parameter.SimplexParam"/>
                            </frequencies>
                        </substModel>
                    </siteModel>
                    <branchRateModel id="StrictClock.c:ca.codon" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                        <clock.rate id="clockRate.c:ca.codon" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</clock.rate>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        
        <operator id="OmegaScaler.s:ca.codon" parameter="@M0.omega.s:ca.codon" scaleFactor="0.5" weight="1.0" spec="beast.base.spec.inference.operator.ScaleOperator"/>
        <operator id="KappaScaler.s:ca.codon" parameter="@M0.kappa.s:ca.codon" scaleFactor="0.5" weight="1.0" spec="beast.base.spec.inference.operator.ScaleOperator"/>
        <operator id="gammaShapeScaler.s:ca.codon" parameter="@gammaShape.s:ca.codon" scaleFactor="0.5" weight="0.1" spec="beast.base.spec.inference.operator.ScaleOperator"/>
        <operator id="CoalescentConstantBICEPSEpochTop.t:ca.codon" spec="beast.base.spec.evolution.operator.IntervalScaleOperator" scaleFactor="0.1" tree="@Tree.t:ca.codon" weight="2.0"/>
        <operator id="CoalescentConstantBICEPSEpochAll.t:ca.codon" spec="beast.base.spec.evolution.operator.IntervalScaleOperator" scaleFactor="0.1" tree="@Tree.t:ca.codon" weight="2.0"/>
        <operator id="CoalescentConstantBICEPSTreeFlex.t:ca.codon" spec="beast.base.spec.evolution.operator.IntervalScaleOperator" scaleFactor="0.01" tree="@Tree.t:ca.codon" weight="2.0"/>
        <operator id="CoalescentConstantTreeRootScaler.t:ca.codon" rootOnly="true" scaleFactor="0.1" tree="@Tree.t:ca.codon" upper="10.0" weight="3.0" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>
        <operator id="CoalescentConstantUniformOperator.t:ca.codon" spec="kernel.BactrianNodeOperator" tree="@Tree.t:ca.codon" weight="30.0"/>
        <operator id="CoalescentConstantSubtreeSlide.t:ca.codon" spec="kernel.BactrianSubtreeSlide" tree="@Tree.t:ca.codon" weight="15.0"/>
        <operator id="CoalescentConstantNarrow.t:ca.codon" spec="Exchange" tree="@Tree.t:ca.codon" weight="15.0"/>
        <operator id="CoalescentConstantWide.t:ca.codon" spec="Exchange" isNarrow="false" tree="@Tree.t:ca.codon" weight="3.0"/>
        <operator id="CoalescentConstantWilsonBalding.t:ca.codon" spec="WilsonBalding" tree="@Tree.t:ca.codon" weight="3.0"/>
        <operator id="PopSizeScaler.t:ca.codon" parameter="@popSize.t:ca.codon" upper="10.0" weight="3.0" spec="beast.base.spec.inference.operator.ScaleOperator"/>
        
        <logger id="tracelog" spec="Logger" fileName="ca.codon.log" logEvery="1000" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log id="TreeHeight.t:ca.codon" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:ca.codon"/>
            <log idref="M0.omega.s:ca.codon"/>
            <log idref="M0.kappa.s:ca.codon"/>
            <log idref="gammaShape.s:ca.codon"/>
            <log idref="popSize.t:ca.codon"/>
            <log idref="CoalescentConstant.t:ca.codon"/>
        </logger>
        
        <logger id="screenlog" spec="Logger" logEvery="1000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="M0.omega.s:ca.codon"/>
            <log idref="M0.kappa.s:ca.codon"/>
        </logger>
        
        <logger id="treelog.t:ca.codon" spec="Logger" fileName="$(tree).trees" logEvery="1000" mode="tree">
            <log id="TreeWithMetaDataLogger.t:ca.codon" spec="beast.base.spec.evolution.TreeWithMetaDataLogger" tree="@Tree.t:ca.codon"/>
        </logger>
    </run>

