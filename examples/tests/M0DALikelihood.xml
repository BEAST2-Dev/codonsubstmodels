    <data id="codon.alignment" data="@alignment" dataType="codon" geneticCode="vertebrateMitochondrial" spec="codonmodels.evolution.alignment.CodonAlignment" verbose="false"/>

    <parameter id="m0.omega" value="0.08" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="NonNegativeReal"/>
    <parameter id="m0.kappa" value="15.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
    <parameter id="popSize" value="0.2" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
    <stateNode id="clockRate" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</stateNode>

    <substModel spec="codonmodels.M0Model" id="m0" verbose="false">
        <omega idref="m0.omega"/>
        <kappa idref="m0.kappa"/>
        <frequencies id="m0.freqs" spec="codonmodels.CodonFrequencies" pi="F3X4" verbose="true">
            <data idref="codon.alignment"/>
        </frequencies>
    </substModel>

    <!-- site model                                                              -->
    <siteModel spec="beast.base.spec.evolution.sitemodel.SiteModel" id="siteModel" gammaCategoryCount="1">
        <!--
        <mutationRate id="mutationRate.m0" estimate="false">1.0</mutationRate>
        <shape id="gammaShape.m0" estimate="false">1.0</shape>
        <proportionInvariant id="proportionInvariant.m0" estimate="false" lower="0.0" upper="1.0">0.0</proportionInvariant>
         -->
        <substModel idref="m0"/>
    </siteModel>

    <tree spec="beast.base.evolution.tree.TreeParser" id="tree" IsLabelledNewick="true" taxa="@alignment" adjustTipHeights="false" newick="(((Chimp_Arnason:0.00353,Chimp_Horai:0.00353):0.175,                  (Human_Arnason:0.0133,Human_Horai:0.01332):0.165):0.1256,                  (Gorilla_Arnason:0.0046,Gorilla_Horai:0.0046):0.23);"/>

    <nodesStates spec="codonmodels.evolution.tree.NodeStatesArray" id="nodesStates">
        <data idref="codon.alignment"/>
    </nodesStates>

    <distribution id="daTreeLikelihood" spec="DataAugTreeLikelihood" threads="4">
<!--        <data idref="codon.alignment"/>-->
        <nodesStates idref="nodesStates"/>
        <tree idref="tree"/>
        <siteModel idref="siteModel"/>
    </distribution>

    <run spec="MCMC" id="mcmc" chainLength="300000"> <!--autoOptimize="true"-->
        <state id="state" storeEvery="10000">
            <input name="stateNode" idref="m0.omega"/>
            <input name="stateNode" idref="m0.kappa"/>
            <input name="stateNode" idref="popSize"/>
            <input name="stateNode" idref="tree"/>
            <input name="stateNode" idref="nodesStates"/>
        </state>

        <distribution spec="beast.base.inference.CompoundDistribution" id="posterior">
            <distribution id="prior" spec="beast.base.inference.CompoundDistribution">
                <distribution id="coalescent" spec="Coalescent">
                    <populationModel id="ConstantPopulation" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation" popSize="@popSize"/>
                    <treeIntervals spec="beast.base.evolution.tree.TreeIntervals" id="beast.base.evolution.tree.TreeIntervals" tree="@tree"/>
                </distribution>
                <distribution id="LogNormalDistributionModel.0" spec="beast.base.spec.inference.distribution.LogNormal" param="@m0.omega">
                        <!-- "1.9064e-02" "1.3534e-01" "9.6075e-01" -->
                        <M id="RealParameter.1" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">-2</M>
                        <S id="RealParameter.2" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1</S>
                    </distribution>
                <distribution id="LogNormalDistributionModel.1" spec="beast.base.spec.inference.distribution.LogNormal" param="@m0.kappa">
                        <!-- 2 to 40  "1.0408e+00" "7.3891e+00" "5.2455e+01" -->
                        <M id="RealParameter.3" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">2</M>
                        <S id="RealParameter.4" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1</S>
                    </distribution>
                <distribution id="LogNormalDistributionModel.2" spec="beast.base.spec.inference.distribution.LogNormal" param="@popSize">
                        <!-- "7.1550e-03" "1.3534e-01" "2.5598e+00" -->
                        <M id="PopM" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">-2</M>
                        <S id="PopS" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.5</S>
                    </distribution>
            </distribution>
            <distribution id="likelihood" spec="beast.base.inference.CompoundDistribution" useThreads="false">
                <distribution idref="daTreeLikelihood"/>
            </distribution>
        </distribution>






        <operator id="GibbsSampler" spec="GibbsSamplingOperator" nodesStates="@nodesStates" tree="@tree" DATreeLikelihood="@daTreeLikelihood" weight="15.0"/>

        <operator id="TreeRootScaler" rootOnly="true" scaleFactor="0.75" tree="@tree" weight="3.0" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>

        <operator id="UniformOperator" tree="@tree" weight="15.0" spec="beast.base.evolution.operator.Uniform"/>


<!--        <operator id="Narrow" spec="Exchange" tree="@tree" weight="15.0"/>-->

<!--        <operator id="Wide" spec="Exchange" isNarrow="false" tree="@tree" weight="3.0"/>-->

<!--        <operator id="WilsonBalding" spec="WilsonBalding" tree="@tree" weight="3.0"/>-->

        <logger logEvery="1000" fileName="m0.da.log" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log spec="beast.base.evolution.tree.TreeStatLogger" tree="@tree"/>
<!--            <log idref="coalescent"/>-->
<!--            <log idref="popSize"/>-->
<!--            <log idref="m0.omega"/>-->
<!--            <log idref="m0.kappa"/>-->
<!--            <log idref="clockRate"/>-->
        </logger>

        <logger logEvery="5000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log spec="beast.base.evolution.tree.TreeStatLogger" tree="@tree"/>
<!--            <log idref="popSize"/>-->
<!--            <log idref="m0.omega"/>-->
<!--            <log id="ESS.0" spec="util.ESS" arg="@m0.omega"/>-->
<!--            <log idref="m0.kappa"/>-->
<!--            <log id="ESS.1" spec="util.ESS" arg="@m0.kappa"/>-->
        </logger>

    </run>

