    <data id="codon.alignment" data="@alignment" dataType="codon" geneticCode="vertebrateMitochondrial" spec="codonmodels.evolution.alignment.CodonAlignment"/>

    <parameter id="m0.omega" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="NonNegativeReal"/>
    <parameter id="m0.kappa" value="2.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
    <parameter id="popSize" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
    <stateNode id="clockRate" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</stateNode>

    <substModel spec="codonmodels.M0Model" id="m0">
        <omega idref="m0.omega"/>
        <kappa idref="m0.kappa"/>
        <frequencies id="m0.freqs" spec="codonmodels.CodonFrequencies" pi="F3X4">
            <data idref="codon.alignment"/>
        </frequencies>
    </substModel>

    <!-- site model                                                              -->
    <siteModel spec="beast.base.spec.evolution.sitemodel.SiteModel" id="siteModel" gammaCategoryCount="1">
        <!--
        <mutationRate id="mutationRate.m0" estimate="false">1.0</mutationRate>
        <shape id="gammaShape.m0" estimate="false">1.0</shape>
        <proportionInvariant id="proportionInvariant.m0" estimate="false" lower="0.0" upper="1.0">0.0</proportionInvariant>
         -->
        <substModel idref="m0"/>
    </siteModel>

    <distribution id="treeLikelihood" spec="beast.base.spec.evolution.likelihood.ThreadedTreeLikelihood">
        <data name="data" idref="codon.alignment"/>
        <tree name="tree" idref="tree"/>
        <siteModel name="siteModel" idref="siteModel"/>
        <branchRateModel id="StrictClock.m0" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel" clock.rate="@clockRate"/>
    </distribution>

    <tree spec="beast.base.spec.evolution.tree.ClusterTree" id="tree" clusterType="upgma">
        <!--<input name='taxa' idref='codon.alignment'/>-->
        <data name="taxa" idref="alignment"/>
    </tree>

    <run spec="MCMC" id="mcmc" chainLength="1000000"> <!--autoOptimize="true"-->
        <state id="state" storeEvery="5000">
            <input name="stateNode" idref="m0.omega"/>
            <input name="stateNode" idref="m0.kappa"/>
            <input name="stateNode" idref="popSize"/>
            <input name="stateNode" idref="tree"/>
        </state>

        <distribution spec="beast.base.inference.CompoundDistribution" id="posterior">
            <distribution id="prior" spec="beast.base.inference.CompoundDistribution">
                <distribution id="coalescent" spec="Coalescent">
                    <populationModel id="ConstantPopulation" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation" popSize="@popSize"/>
                    <treeIntervals spec="beast.base.evolution.tree.TreeIntervals" id="beast.base.evolution.tree.TreeIntervals" tree="@tree"/>
                </distribution>
                <distribution id="LogNormalDistributionModel.0" spec="beast.base.spec.inference.distribution.LogNormal" param="@m0.omega">
                        <!-- "1.9064e-02" "1.3534e-01" "9.6075e-01" -->
                        <M id="RealParameter.1" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">-2</M>
                        <S id="RealParameter.2" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1</S>
                    </distribution>
                <distribution id="LogNormalDistributionModel.1" spec="beast.base.spec.inference.distribution.LogNormal" param="@m0.kappa">
                        <!-- 2 to 40  "1.0408e+00" "7.3891e+00" "5.2455e+01" -->
                        <M id="RealParameter.3" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">2</M>
                        <S id="RealParameter.4" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1</S>
                    </distribution>
                <distribution id="PopSizePrior" spec="beast.base.spec.inference.distribution.Gamma" param="@popSize"><alpha spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="0.01" estimate="false"/><theta spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="100.0" estimate="false"/></distribution>
            </distribution>
            <distribution id="likelihood" spec="beast.base.inference.CompoundDistribution" useThreads="true">
                <distribution idref="treeLikelihood"/>
            </distribution>
        </distribution>


        <operator id="omegaScaler" parameter="@m0.omega" scaleFactor="0.5" weight="0.5" spec="beast.base.spec.inference.operator.ScaleOperator"/>

        <operator id="kappaScaler" parameter="@m0.kappa" scaleFactor="0.5" weight="3" spec="beast.base.spec.inference.operator.ScaleOperator"/>

        <operator id="popSizeScaler" parameter="@popSize" scaleFactor="0.75" weight="0.5" spec="beast.base.spec.inference.operator.ScaleOperator"/>

        <operator id="treeScaler" scaleFactor="0.5" tree="@tree" weight="3.0" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>

        <operator id="TreeRootScaler" rootOnly="true" scaleFactor="0.5" tree="@tree" weight="3.0" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>

        <operator id="UniformOperator" tree="@tree" weight="30.0" spec="beast.base.evolution.operator.Uniform"/>

        <operator id="SubtreeSlide" spec="beast.base.evolution.operator.kernel.BactrianSubtreeSlide" tree="@tree" size="0.1" weight="15.0"/>

        <operator id="Narrow" spec="Exchange" tree="@tree" weight="15.0"/>

        <operator id="Wide" spec="Exchange" isNarrow="false" tree="@tree" weight="3.0"/>

        <operator id="WilsonBalding" spec="WilsonBalding" tree="@tree" weight="3.0"/>

        <logger logEvery="2000" fileName="test.m0.log" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="coalescent"/>
            <log idref="popSize"/>
            <log idref="m0.omega"/>
            <log idref="m0.kappa"/>
            <log idref="clockRate"/>
        </logger>

        <logger logEvery="10000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="popSize"/>
            <log idref="m0.omega"/>
            <log id="ESS.0" spec="beast.base.spec.inference.util.ESS" arg="@m0.omega"/>
            <log idref="m0.kappa"/>
            <log id="ESS.1" spec="beast.base.spec.inference.util.ESS" arg="@m0.kappa"/>
        </logger>

        <logger logEvery="5000" fileName="test.m0.trees" mode="tree">
            <log id="TreeWithMetaDataLogger.t:Dengue4" spec="beast.base.spec.evolution.TreeWithMetaDataLogger" tree="@tree"/>
        </logger>
    </run>

</beast>
