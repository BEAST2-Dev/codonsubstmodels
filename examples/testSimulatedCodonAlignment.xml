      <data idref="codon0"/>

                    <siteModel id="trueSiteModel.s:codon" spec="beast.base.spec.evolution.sitemodel.SiteModel" gammaCategoryCount="4" shape="0.3639569748087765">
                        <mutationRate id="truemutationRate.s:codon" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</mutationRate>
                        <proportionInvariant id="trueproportionInvariant.s:codon" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval">0.0</proportionInvariant>
                        
                        <substModel id="trueGCS.s:codon" spec="codonmodels.GeneralCodonSubstitutionModel" omega="0.03092812548417194" substitutionRate="1 1 1" mnmPenalty="0 0">
                        	
                        	<substModel id="trueRevJump.s:codon" spec="bmodeltest.evolution.substitutionmodel.NucleotideRevJumpSubstModel" modelIndicator="1" rates="0.7584865383228111 1.4830269233543767 0.8704941111561588 0.15953675795454386 1.238574299147703 0.08283905597541787" modelSet="transitionTransversionSplit">
                	    	    <frequencies id="trueBMTfreqs.s:codon" spec="beast.base.spec.evolution.substitutionmodel.Frequencies"><frequencies spec="beast.base.spec.inference.parameter.SimplexParam" value="0.25 0.25 0.25 0.25"/></frequencies>
		            	    </substModel>
		            	    
                        	<substModel id="trueRevJump2.s:codon" spec="bmodeltest.evolution.substitutionmodel.NucleotideRevJumpSubstModel" modelIndicator="13" rates="0.03083397519968288 2.4276845123522217 0.2793792431865226 0.8035837817096685 0.7906232696759422 0.6621065010809529" modelSet="transitionTransversionSplit">
                	    	    <frequencies id="trueBMTfreqs2.s:codon" spec="beast.base.spec.evolution.substitutionmodel.Frequencies"><frequencies spec="beast.base.spec.inference.parameter.SimplexParam" value="0.25 0.25 0.25 0.25"/></frequencies>
		            	    </substModel>
		            	    
                        	<substModel id="trueRevJump3.s:codon" spec="bmodeltest.evolution.substitutionmodel.NucleotideRevJumpSubstModel" modelIndicator="28" rates="0.6698491053978358 2.4386033683150514 0.5985384747787752 1.5661653597377772 0.12830521699178224 0.13057457375854534" modelSet="transitionTransversionSplit">
                	    	    <frequencies id="trueBMTfreqs3.s:codon" spec="beast.base.spec.evolution.substitutionmodel.Frequencies"><frequencies spec="beast.base.spec.inference.parameter.SimplexParam" value="0.25 0.25 0.25 0.25"/></frequencies>
		            	    </substModel>

                            <frequencies id="truecodonFreqs.s:codon" spec="codonmodels.GeneralCodonFrequencies" estimate="false"> 
                            	<freq id="trueBMT_frequencies1.s:codon" dimension="4" value="0.23235855412189937 0.2855395395151793 0.21533710349891638 0.266764802864005" spec="beast.base.spec.inference.parameter.SimplexParam"/>
                            </frequencies>
                        </substModel>
                    </siteModel>
       <branchRateModel id="trueStrictClock.c:dna" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel" clock.rate="1.0"/>
    </data>

    <run id="mcmc" spec="MCMC" chainLength="1000000">
        <state id="state" spec="State" storeEvery="5000">
            <tree id="Tree.t:codon" spec="beast.base.evolution.tree.Tree" name="stateNode">
                <taxonset id="TaxonSet.codon" spec="TaxonSet" alignment="@codon">
                </taxonset>
            </tree>
            <stateNode id="M0.omega.s:codon" spec="beast.base.spec.inference.parameter.RealVectorParam" dimension="1" domain="NonNegativeReal">1.0</stateNode>
            <stateNode id="gammaShape.s:codon" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">1.0</stateNode>
            <stateNode id="popSize.t:codon" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">0.3</stateNode>
	        <stateNode id="BMT_ModelIndicator.s:codon" spec="beast.base.spec.inference.parameter.IntScalarParam" domain="NonNegativeInt">5</stateNode>
    	    <stateNode id="BMT_Rates.s:codon" dimension="6" spec="beast.base.spec.inference.parameter.RealVectorParam" domain="PositiveReal">1.0</stateNode>

	        <stateNode id="BMT_ModelIndicator2.s:codon" spec="beast.base.spec.inference.parameter.IntScalarParam" domain="NonNegativeInt">5</stateNode>
    	    <stateNode id="BMT_Rates2.s:codon" dimension="6" spec="beast.base.spec.inference.parameter.RealVectorParam" domain="PositiveReal">1.0</stateNode>
	        <stateNode id="BMT_ModelIndicator3.s:codon" spec="beast.base.spec.inference.parameter.IntScalarParam" domain="NonNegativeInt">5</stateNode>
    	    <stateNode id="BMT_Rates3.s:codon" dimension="6" spec="beast.base.spec.inference.parameter.RealVectorParam" domain="PositiveReal">1.0</stateNode>

            <stateNode idref="BMT_frequencies1.s:codon"/>
            <stateNode id="mnmPenalty.s:codon" dimension="2" spec="beast.base.spec.inference.parameter.RealVectorParam" domain="NonNegativeReal">0.0</stateNode>
            <stateNode id="substitutionRate.s:codon" dimension="3" spec="beast.base.spec.inference.parameter.RealVectorParam" domain="PositiveReal">1.0</stateNode>
        </state>
        
        <init id="RandomTree.t:codon" spec="beast.base.spec.evolution.tree.coalescent.RandomTree" estimate="false" initial="@Tree.t:codon" taxa="@codon">
            <populationModel id="ConstantPopulation0.t:codon" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
                <popSize id="randomPopSize.t:codon" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</popSize>
            </populationModel>
        </init>
        
        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="CoalescentConstant.t:codon" spec="Coalescent">
                    <populationModel id="ConstantPopulation.t:codon" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation" popSize="@popSize.t:codon"/>
                    <treeIntervals id="TreeIntervals.t:codon" spec="beast.base.evolution.tree.TreeIntervals" tree="@Tree.t:codon"/>
                </distribution>
                
		        <distribution id="BMT_RatesPrior.s:codon" spec="bmodeltest.math.distributions.NucleotideRevJumpSubstModelRatePrior" modelIndicator="@BMT_ModelIndicator.s:codon" x="@BMT_Rates.s:codon" priorType="onTransitionsAndTraversals" substModel="@RevJump.s:codon"/>
		        <distribution id="BMT_RatesPrior2.s:codon" spec="bmodeltest.math.distributions.NucleotideRevJumpSubstModelRatePrior" modelIndicator="@BMT_ModelIndicator2.s:codon" x="@BMT_Rates2.s:codon" priorType="onTransitionsAndTraversals" substModel="@RevJump2.s:codon"/>
		        <distribution id="BMT_RatesPrior3.s:codon" spec="bmodeltest.math.distributions.NucleotideRevJumpSubstModelRatePrior" modelIndicator="@BMT_ModelIndicator3.s:codon" x="@BMT_Rates3.s:codon" priorType="onTransitionsAndTraversals" substModel="@RevJump3.s:codon"/>

                <distribution id="LogNormalDistributionModel.0" spec="beast.base.spec.inference.distribution.IID" param="@M0.omega.s:codon"><distr spec="beast.base.spec.inference.distribution.LogNormal">
                        <M id="RealParameter.0" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">-3.0</M>
                        <S id="RealParameter.1" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.25</S>
                    </distr></distribution>
                <distribution id="Exponential.0" spec="beast.base.spec.inference.distribution.Exponential" param="@gammaShape.s:codon">
                        <mean id="RealParameter.4" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</mean>
                    </distribution>
                <distribution id="PopSizePrior.t:codon" spec="beast.base.spec.inference.distribution.LogNormal" param="@popSize.t:codon" meanInRealSpace="true" M="1.0" S="0.05"/>
                
                <distribution id="BMT_freqsPrior1.s:codon" spec="beast.base.spec.inference.distribution.Dirichlet" param="@BMT_frequencies1.s:codon"><alpha spec="beast.base.spec.inference.parameter.RealVectorParam" domain="PositiveReal" value="4.0 4.0 4.0 4.0"/></distribution>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                <distribution id="treeLikelihood.codon" spec="beast.base.spec.evolution.likelihood.ThreadedTreeLikelihood" data="@codon" tree="@Tree.t:codon" useAmbiguities="true">
                    <siteModel id="SiteModel.s:codon" spec="beast.base.spec.evolution.sitemodel.SiteModel" gammaCategoryCount="4" shape="@gammaShape.s:codon">
                        <mutationRate id="mutationRate.s:codon" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">1.0</mutationRate>
                        <proportionInvariant id="proportionInvariant.s:codon" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval">0.0</proportionInvariant>
                        
                        <substModel id="GCS.s:codon" spec="codonmodels.GeneralCodonSubstitutionModel" omega="@M0.omega.s:codon" substitutionRate="@substitutionRate.s:codon" mnmPenalty="@mnmPenalty.s:codon">
                        	<substModel id="RevJump.s:codon" spec="bmodeltest.evolution.substitutionmodel.NucleotideRevJumpSubstModel" modelIndicator="@BMT_ModelIndicator.s:codon" rates="@BMT_Rates.s:codon" modelSet="transitionTransversionSplit">
                	    	    <frequencies id="BMTfreqs.s:codon" spec="beast.base.spec.evolution.substitutionmodel.Frequencies"><frequencies spec="beast.base.spec.inference.parameter.SimplexParam" value="0.25 0.25 0.25 0.25"/></frequencies>
		            	    </substModel>
                        	<substModel id="RevJump2.s:codon" spec="bmodeltest.evolution.substitutionmodel.NucleotideRevJumpSubstModel" modelIndicator="@BMT_ModelIndicator2.s:codon" rates="@BMT_Rates2.s:codon" modelSet="transitionTransversionSplit">
                	    	    <frequencies id="BMTfreqs2.s:codon" spec="beast.base.spec.evolution.substitutionmodel.Frequencies"><frequencies spec="beast.base.spec.inference.parameter.SimplexParam" value="0.25 0.25 0.25 0.25"/></frequencies>
		            	    </substModel>
                        	<substModel id="RevJump3.s:codon" spec="bmodeltest.evolution.substitutionmodel.NucleotideRevJumpSubstModel" modelIndicator="@BMT_ModelIndicator3.s:codon" rates="@BMT_Rates3.s:codon" modelSet="transitionTransversionSplit">
                	    	    <frequencies id="BMTfreqs3.s:codon" spec="beast.base.spec.evolution.substitutionmodel.Frequencies"><frequencies spec="beast.base.spec.inference.parameter.SimplexParam" value="0.25 0.25 0.25 0.25"/></frequencies>
		            	    </substModel>
		            	    
                            <frequencies id="codonFreqs.s:codon" spec="codonmodels.GeneralCodonFrequencies" estimate="false"> 
                            	<freq id="BMT_frequencies1.s:codon" dimension="4" value="0.25" spec="beast.base.spec.inference.parameter.SimplexParam"/>
                            </frequencies>
                        </substModel>
                    </siteModel>
                    <branchRateModel id="StrictClock.c:codon" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                        <clock.rate id="clockRate.c:codon" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</clock.rate>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        
        <operator id="OmegaScaler.s:codon" parameter="@M0.omega.s:codon" scaleFactor="0.5" weight="1.0" spec="beast.base.spec.inference.operator.ScaleOperator"/>
        <operator id="gammaShapeScaler.s:codon" parameter="@gammaShape.s:codon" scaleFactor="0.5" weight="0.1" spec="beast.base.spec.inference.operator.ScaleOperator"/>
        <operator id="CoalescentConstantBICEPSEpochTop.t:codon" spec="beast.base.spec.evolution.operator.IntervalScaleOperator" scaleFactor="0.1" tree="@Tree.t:codon" weight="2.0"/>
        <operator id="CoalescentConstantBICEPSEpochAll.t:codon" spec="beast.base.spec.evolution.operator.IntervalScaleOperator" scaleFactor="0.1" tree="@Tree.t:codon" weight="2.0"/>
        <operator id="CoalescentConstantBICEPSTreeFlex.t:codon" spec="beast.base.spec.evolution.operator.IntervalScaleOperator" scaleFactor="0.01" tree="@Tree.t:codon" weight="2.0"/>
        <operator id="CoalescentConstantTreeRootScaler.t:codon" rootOnly="true" scaleFactor="0.1" tree="@Tree.t:codon" upper="10.0" weight="3.0" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>
        <operator id="CoalescentConstantUniformOperator.t:codon" spec="kernel.BactrianNodeOperator" tree="@Tree.t:codon" weight="30.0"/>
        <operator id="CoalescentConstantSubtreeSlide.t:codon" spec="kernel.BactrianSubtreeSlide" tree="@Tree.t:codon" weight="15.0"/>
        <operator id="CoalescentConstantNarrow.t:codon" spec="Exchange" tree="@Tree.t:codon" weight="15.0"/>
        <operator id="CoalescentConstantWide.t:codon" spec="Exchange" isNarrow="false" tree="@Tree.t:codon" weight="3.0"/>
        <operator id="CoalescentConstantWilsonBalding.t:codon" spec="WilsonBalding" tree="@Tree.t:codon" weight="3.0"/>
        <operator id="PopSizeScaler.t:codon" parameter="@popSize.t:codon" upper="10.0" weight="3.0" spec="beast.base.spec.inference.operator.ScaleOperator"/>
        
        <operator id="BMT_ModelTestOperator.s:codon" spec="bmodeltest.evolution.operators.BMTMergeSplitOperator" modelIndicator="@BMT_ModelIndicator.s:codon" rates="@BMT_Rates.s:codon" substModel="@RevJump.s:codon" weight="1.0"/>
        <operator id="BMT_Ratescaler.s:codon" spec="bmodeltest.evolution.operators.BMTExchangeOperator" modelIndicator="@BMT_ModelIndicator.s:codon" rates="@BMT_Rates.s:codon" substModel="@RevJump.s:codon" delta="0.15" weight="1.0"/>

        <operator id="BMT_ModelTestOperator2.s:codon" spec="bmodeltest.evolution.operators.BMTMergeSplitOperator" modelIndicator="@BMT_ModelIndicator2.s:codon" rates="@BMT_Rates2.s:codon" substModel="@RevJump2.s:codon" weight="1.0"/>
        <operator id="BMT_Ratescaler2.s:codon" spec="bmodeltest.evolution.operators.BMTExchangeOperator" modelIndicator="@BMT_ModelIndicator2.s:codon" rates="@BMT_Rates2.s:codon" substModel="@RevJump2.s:codon" delta="0.15" weight="1.0"/>

        <operator id="BMT_ModelTestOperator3.s:codon" spec="bmodeltest.evolution.operators.BMTMergeSplitOperator" modelIndicator="@BMT_ModelIndicator3.s:codon" rates="@BMT_Rates3.s:codon" substModel="@RevJump3.s:codon" weight="1.0"/>
        <operator id="BMT_Ratescaler3.s:codon" spec="bmodeltest.evolution.operators.BMTExchangeOperator" modelIndicator="@BMT_ModelIndicator3.s:codon" rates="@BMT_Rates3.s:codon" substModel="@RevJump3.s:codon" delta="0.15" weight="1.0"/>

        <operator id="BMT_FrequenciesExchanger1.s:codon" spec="beast.base.spec.inference.operator.DeltaExchangeOperator" delta="0.01" weight="0.2" parameter="@BMT_frequencies1.s:codon"/>
        <operator id="BMT_mnmPenaltyScaler.s:codon" parameter="@mnmPenalty.s:codon" scaleFactor="0.5" weight="1.0" spec="beast.base.spec.inference.operator.ScaleOperator"/>

        <operator id="updown.s:codon" spec="beast.base.spec.evolution.operator.UpDownOperator" scaleFactor="0.5" weight="5.0">
        	<up idref="Tree.t:codon"/>
        	<down idref="M0.omega.s:codon"/>
        </operator>

        <logger id="tracelog" spec="Logger" fileName="$(filebase).log" logEvery="1000" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log id="TreeHeight.t:codon" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:codon"/>
            <log idref="M0.omega.s:codon"/>
            <log idref="gammaShape.s:codon"/>
            <log idref="popSize.t:codon"/>
            <log idref="CoalescentConstant.t:codon"/>
            <log idref="RevJump.s:codon"/>
            <log idref="BMT_ModelIndicator.s:codon"/>
            <log idref="BMT_frequencies1.s:codon"/>

            <log idref="RevJump2.s:codon"/>
            <log idref="BMT_ModelIndicator2.s:codon"/>

            <log idref="RevJump3.s:codon"/>
            <log idref="BMT_ModelIndicator3.s:codon"/>
            <log idref="mnmPenalty.s:codon"/>
            <log idref="substitutionRate.s:codon"/>            
        </logger>
        
        <logger id="screenlog" spec="Logger" logEvery="1000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="M0.omega.s:codon"/>
        </logger>
        
        <logger id="treelog.t:codon" spec="Logger" fileName="$(filebase).trees" logEvery="1000" mode="tree">
            <log id="TreeWithMetaDataLogger.t:codon" spec="beast.base.spec.evolution.TreeWithMetaDataLogger" tree="@Tree.t:codon"/>
        </logger>
    </run>

</beast>
